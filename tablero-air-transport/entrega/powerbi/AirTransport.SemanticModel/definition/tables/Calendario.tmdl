table Calendario
	dataCategory: Time

	column Date
		dataType: dateTime
		formatString: Short Date
		isKey
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]
	column Año
		dataType: int64
		formatString: 0
		summarizeBy: none
		isNameInferred
		sourceColumn: [Año]
	column MesNum
		dataType: int64
		formatString: 0
		summarizeBy: none
		isNameInferred
		sourceColumn: [MesNum]
	column Mes
		dataType: string
		summarizeBy: none
		sortByColumn: MesNum
		isNameInferred
		sourceColumn: [Mes]
	column AñoMes
		dataType: string
		summarizeBy: none
		isNameInferred
		sourceColumn: [AñoMes]

	partition Calendario = calculated
		mode: import
		source = ADDCOLUMNS(CALENDAR(DATE(2020,1,1), DATE(2022,12,31)), "Año", YEAR([Date]), "MesNum", MONTH([Date]), "Mes", FORMAT([Date], "mmm"), "AñoMes", FORMAT([Date], "yyyy-mm"))
